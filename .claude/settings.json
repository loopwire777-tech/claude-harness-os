{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-db-reset.sh",
            "if": "Bash(*migrate reset*)",
            "statusMessage": "Checking for destructive db reset..."
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/block-db-reset.sh",
            "if": "Bash(*db:reset*)",
            "statusMessage": "Checking for destructive db reset..."
          }
        ]
      }
    ]
  }
}
